{
  "layer": "top",
  "position": "top",
  "autohide": true,
  "autohide-blocked": false,
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  
  /* === Modules Order === */
  "modules-left": ["custom/archicon","cpu","memory","disk"],
  "modules-center": ["hyprland/workspaces"],
  "modules-right": ["custom/godot","custom/discord","custom/firefox","pulseaudio/slider","pulseaudio","network","clock","group/sysctl"],
 
 /* === modules-left-config=== */
  "custom/archicon": {
	"format": "   ",
	"tooltip": false,
  },

  "cpu": {
   "format": " \uf4bc  {usage}% ",
   "tooltip": true,
  },
    
  "memory": {
	"format": " \uefc5   {used:0.1f}G / {total:0.0f}G  ",
  },

  "disk": {
	"format": " \uf0c7  {specific_used:0.0f}GB/{specific_total:0.0f}GB  ",
  	"unit": "GB",
  }, 
 
  /* === modules-left-config === */
  "hyprland/workspaces": {
	"disable-scroll": true,
	"on-click": "activate",
  	"persistent-workspaces": {
		"1": [],
		"2": [],
		"3": [],
		"4": [],
	}
  },
  
  /* === modules-right-config === */
  "custom/firefox":{
  	"format": "  <span font='16' rise='3000'>\uf269</span>   ",
	"on-click": "firefox",
	"tooltip": false,
  },

  "custom/godot":{
  	"format": "  <span font='20' rise='3000'>\ue7ee</span>   ",
	"on-click": "godot",
	"tooltip": false,
  },

  "custom/discord":{
  	"format": "  <span font='16' rise='3000'>\uf1ff</span>    ",
	"on-click": "discord",
	"tooltip": false,
  },

  "pulseaudio/slider": {
  	"min": 0,
	"max": 100,
	"orientation": "horizontal",
  },
  
  "pulseaudio": {
  	"format": " \uf028   {volume}%  ",
	"format-muted": " \ueee8     ",
	"scroll-step": 0.0,
	"tooltip": false,
	"on-click-right": "pavucontrol",
	"on-click": "pactl set-sink-mute 0  toggle"
  }, 
 
  "network": {
	"interval": 15,
	"format-ethernet": "  {ifname}\udb80\ude01 ",
	"format-disconnected": "Disconnected \udb80\ude02 ",
  	"tooltip": true,
	"tooltip-format": "[Device]\t\t{ifname}\n[IPv4]\t\t{ipaddr}\n[Subnetmask] {netmask}\n\uf019  {bandwidthDownBytes}  \uf093  {bandwidthUpBytes}",
	"tooltip-format-disconnected": "No network device connected..",
  },
 
  "clock":{
	"format": "  {:%H:%M \udb82\udd54  | %d.%m.%y \uf073}  ",
	"tooltip": false,
	"max-length":25,
  },

  "group/sysctl": {
  	"orientation": "inherit",
	"modules":["custom/pwer_off", "custom/lock", "custom/reboot"],
	"children-class": "drawer-child",
	"drawer": {
		"transition-duration": 500,
		"transition-left-to-right":false,
	},
	"click-to-reveal": true,
  },
  
  "custom/pwer_off": {
  	"format": " \u23fb ",
  	"on-click": "sh -c 'sleep 1 && systemctl poweroff' &",
	"tooltip": false, 
  },

  "custom/reboot": {
  	"format": " \uead2 ",
  	"on-click": "sh -c 'sleep 1 && systemctl reboot' &",
	"tooltip": false,
   },
  
  "custom/lock": {
  	"format": " \udb80\udf3e ",
  	"on-click": "hyprlock",
	"tooltip": false,
  },
}
 

